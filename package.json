{
  "name": "gok-vein-gambit",
  "version": "0.9.7",
  "private": true,
  "description": "《戈克世界：流脉牌局》八阵营流脉卡牌对战",
  "author": "戈克世界",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:win": "electron-builder --win nsis",
    "package": "electron-builder --win nsis",
    "release": "pwsh -NoProfile -File tools/build-release.ps1",
    "sim": "node scripts/simulate.mjs",
    "assert:cards": "node tests/card-assertions.js",
    "test:cards": "node tests/card-assertions.js",
    "test:embed": "node tests/embedded-server-check.js"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.64.1"
  },
  "build": {
    "appId": "world.gok.vein-gambit",
    "productName": "GokVeinGambit",
    "copyright": "戈克世界",
    "icon": "launcher/icon.ico",
    "asar": true,
    "files": [
      "electron/**/*",
      "public/**/*",
      "server/server.js",
      "server/auth.js",
      "server/auth_pg.js",
      "package.json",
      "!public/assets/generated/*-raw/**",
      "!public/assets/generated/jimeng-raw*/**"
    ],
    "directories": {
      "output": "发布/安装包",
      "buildResources": "launcher"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "GokVeinGambit-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "戈克世界：流脉牌局",
      "uninstallDisplayName": "戈克世界：流脉牌局 ${version}",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052"
    }
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
